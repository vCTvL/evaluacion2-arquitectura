# --- Configuración SMTP (elige y completa una) ---
# Opción A: Mailtrap (desarrollo/testing)
# Regístrate en https://mailtrap.io y copia HOST, PORT, USER, PASS
#SMTP_HOST=smtp.mailtrap.io
#SMTP_PORT=2525
#SMTP_USER=tu_user_mailtrap
#SMTP_PASS=tu_pass_mailtrap
#SMTP_FROM="Clínica Salud Integral" <no-reply@clinica.com>
#SMTP_SECURE=false

# Opción B: Gmail (producción - usar App Password, no la contraseña normal)
# 1) Habilitar 2FA en la cuenta Google
# 2) Crear App Password (tipo "Mail")
# 3) Usar SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y SMTP_SECURE=true
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=465
#SMTP_USER=tu-cuenta@gmail.com
#SMTP_PASS=tu_app_password
#SMTP_FROM="Clínica Salud Integral" <tu-cuenta@gmail.com>
#SMTP_SECURE=true

# Opción C: Outlook / Office365
#SMTP_HOST=smtp.office365.com
#SMTP_PORT=587
#SMTP_USER=tu-cuenta@empresa.com
#SMTP_PASS=tu_password
#SMTP_FROM="Clínica Salud Integral" <no-reply@empresa.com>
#SMTP_SECURE=false

# Opción D: Ejemplo genérico (no funcionará si no reemplazas valores)
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_USER=usuario@smtp.com
SMTP_PASS=tu_password_smtp
SMTP_FROM="Clínica Salud Integral" <no-reply@clinica.com>
SMTP_SECURE=false

# Si NO configuras ninguna de las anteriores, la app usará Ethereal (solo para pruebas)
# --- Fin configuración SMTP ---

# JWT
JWT_SECRET=un_valor_muy_secreto_y_largo

# Base de datos
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=clinica

# Puerto de la app (opcional)
PORT=3000